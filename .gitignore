/target
.idea

# Out-of-workspace packages build into their own directory. Their lockfiles are
# tracked, because a recorded result describes the dependency versions it was
# taken with.
docs/spikes/*/target/

# Generated trace output. Raw traces are large and contain the case input
# values, so only the compact fixtures under tests/fixtures are tracked.
*.trace
!crates/trace-check/tests/fixtures/*.trace
*.log
/traces/

# Generated reports. The committed artifact-baseline.json is not one of these.
# A symbolic report can contain a counterexample's secret values, which is
# another reason not to track one.
*-report.json
*-screen.json
native-memcheck.json
m3-consumer.json
m4-symbolic.json
m5-library.json

# Python bytecode from the spike readers.
__pycache__/
*.pyc
